# ── Backend (Go) ──
API_PORT=9000

# Database
DATABASE_URL=postgres://postgres:password@localhost:5532/colight?sslmode=disable
# Production: Set via your deployment platform
# Example: postgres://user:password@host:5432/colight?sslmode=require

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars

# Naver OAuth
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_CALLBACK_URL=http://localhost:9000/v1/auth/naver/callback

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
LLM_LIGHT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Models are configured per-prompt in /admin/prompts

# External APIs
DART_API_KEY=your-dart-api-key

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:4000
